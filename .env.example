# HEARTROT — environment template. NAMES ONLY. Never commit a value into this file.
#
# Worker (server) values:
#   local  -> copy to worker/.dev.vars (wrangler reads .dev.vars, not .env)
#   deploy -> `pnpm --filter @heartrot/worker exec wrangler secret put <NAME>`
#
# Client (browser) values must be prefixed VITE_ to be exposed by Vite, and are therefore
# PUBLIC — they are inlined into the JS bundle. Nothing secret may ever carry that prefix.
#
# Non-secret routing constants (ER_ENDPOINT, ROUTER_ENDPOINT, VALIDATOR_IDENTITY,
# PROGRAM_ID) are not here; they live in `vars` in worker/wrangler.jsonc.

# --- Worker secrets -----------------------------------------------------------------

# Base-layer RPC, full URL including the provider's API key. Must be a paid/dedicated
# provider: api.devnet.solana.com returns HTTP 403 to Cloudflare Worker egress.
BASE_RPC_URL=

# Treasury signing key, base58-encoded 64-byte Ed25519 secret key. Pays rent, delegation,
# undelegation and the base-layer leaderboard write. Imported non-extractable, so it can
# be loaded but never exported back out of the Worker.
TREASURY_SECRET_KEY=

# Privy application id. Used server-side to build the JWKS URL and as the expected JWT
# `aud`. Not itself a secret, but the Worker's auth check is meaningless without it.
PRIVY_APP_ID=

# --- Client (public, inlined into the bundle) ---------------------------------------

# Same Privy app id, for the browser SDK.
VITE_PRIVY_APP_ID=
