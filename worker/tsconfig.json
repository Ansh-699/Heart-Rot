{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": []
  },
  // `worker-configuration.d.ts` is generated by `pnpm --filter @heartrot/worker types`
  // (i.e. `wrangler types`) and is what defines `Env` from wrangler.jsonc's vars and
  // bindings. Run that script once after cloning, and again after editing wrangler.jsonc.
  "include": ["src", "worker-configuration.d.ts"]
}
