# Privy application id. Public by construction (it is inlined into the bundle), but the
# build refuses to run without it — see requireIdentityEnv in vite.config.ts.
#
# Must be the SAME Privy app as the Worker's PRIVY_APP_ID: the Worker derives its JWKS URL
# and its expected `aud` from its own copy, so a mismatch rejects every token with
# "invalid privy token" and nothing on screen explains why.
VITE_PRIVY_APP_ID=
